{
  "name": "djinn-test",
  "networks": {
    "djinn-network": {
      "name": "djinn-test-network",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "agent-docker": {
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "3221225472"
          },
          "reservations": {
            "cpus": 1,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "restart": "no",
      "container_name": "djinn-test-agent-docker",
      "command": [
        "dockerd",
        "--host=unix:///home/rootless/.djinn-docker/socket/docker.sock",
        "--config-file=/dev/null",
        "--data-root=/home/rootless/.local/share/docker",
        "--storage-driver=overlay2",
        "--tls=false"
      ],
      "devices": [
        {
          "source": "/dev/net/tun",
          "target": "/dev/net/tun",
          "permissions": "rwm"
        }
      ],
      "entrypoint": [
        "/bin/sh",
        "-ec",
        "if [ \"$${DJINN_FIREWALL_GATE}\" = true ]; then\n  while [ ! -f /home/rootless/.djinn-docker/firewall-ready ]; do sleep 0.1; done\n  rm /home/rootless/.djinn-docker/firewall-ready\nfi\nmkdir -p /home/rootless/.djinn-docker/socket\nexec /usr/local/bin/dockerd-entrypoint.sh \"$$@\"\n",
        "djinn-agent-docker"
      ],
      "environment": {
        "DJINN_FIREWALL_GATE": "true",
        "DOCKER_TLS_CERTDIR": ""
      },
      "image": "sha256:3acba49741f1aedb28125ffb2307faaec8e870ebb9343de41c21ac549bd6abf0",
      "labels": {
        "djinn.git-agent.generation": "34bf8ae67c2b4b39b186e8e85792556d"
      },
      "networks": {
        "djinn-network": {
          "aliases": [
            "agent-docker"
          ]
        }
      },
      "security_opt": [
        "seccomp=unconfined",
        "systempaths=unconfined"
      ],
      "stop_grace_period": "20s",
      "tmpfs": [
        "/var/lib/docker"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "type": "bind",
          "source": "/tmp/djinn-test/code",
          "target": "/home/dev/projects",
          "bind": {
            "propagation": "rprivate",
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/tmp/djinn-test/home/.djinn/sessions",
          "target": "/home/dev/sessions",
          "bind": {
            "propagation": "rprivate",
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/tmp/djinn-test/readonly",
          "target": "/fixture-readonly",
          "read_only": true,
          "bind": {
            "propagation": "rprivate",
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/tmp/djinn-test/declared",
          "target": "/fixture-declared",
          "bind": {
            "propagation": "rprivate",
            "create_host_path": false
          }
        },
        {
          "type": "volume",
          "source": "djinn-test-inner-data",
          "target": "/fixture-volume"
        },
        {
          "type": "volume",
          "source": "agent-docker-data",
          "target": "/home/rootless/.local/share/docker"
        },
        {
          "type": "volume",
          "source": "agent-docker-endpoint",
          "target": "/home/rootless/.djinn-docker",
          "volume": {
            "nocopy": true
          }
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "info=$$(docker --host unix:///home/rootless/.djinn-docker/socket/docker.sock info --format '{{.Driver}} {{.DockerRootDir}} {{json .SecurityOptions}}') \u0026\u0026 case \"$$info\" in 'overlay2 /home/rootless/.local/share/docker '*\\\"name=rootless\\\"*) exit 0;; *) exit 1;; esac"
        ],
        "timeout": "5s",
        "interval": "2s",
        "retries": 3,
        "start_period": "1m0s"
      }
    },
    "dev": {
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "3221225472"
          },
          "reservations": {
            "cpus": 1,
            "memory": "536870912"
