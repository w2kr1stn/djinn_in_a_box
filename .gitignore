# Environment configuration (contains local paths) — root-anchored so the
# shipped templates/seed/** copies stay trackable
/.env
/packages.txt
/tools/tools.txt

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Session/Task files (AI agent working files)
/.claude/
/CLAUDE.md
/PLAN.md
/TASKS.yml

# Local-only user configuration (the "blank space") — seeded from templates/seed/
# on first run, owned by the user, never published. Root-anchored: the shipped
# templates/seed/config/** must remain trackable.
/config/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/
.pytest_cache
.ruff_cache

# Test
.coverage

# Node
node_modules/

# Logs
logs/
*.log

# Docker
.docker/
